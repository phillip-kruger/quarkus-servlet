<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.servlet</groupId>
        <artifactId>quarkus-servlet-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>quarkus-servlet-tck</artifactId>
    <name>Quarkus Servlet - TCK</name>
    <description>Jakarta Servlet 6.1 TCK runner for quarkus-servlet</description>

    <properties>
        <servlet.tck.version>6.1.2</servlet.tck.version>
        <arquillian.version>1.10.2.Final</arquillian.version>
        <maven.deploy.skip>true</maven.deploy.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Our extension runtime -->
        <dependency>
            <groupId>io.quarkiverse.servlet</groupId>
            <artifactId>quarkus-servlet</artifactId>
        </dependency>

        <!-- web.xml parsing -->
        <dependency>
            <groupId>org.jboss.metadata</groupId>
            <artifactId>jboss-metadata-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.jboss.spec.javax.servlet</groupId>
                    <artifactId>jboss-servlet-api_3.1_spec</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- The TCK tests -->
        <dependency>
            <groupId>jakarta.servlet.tck</groupId>
            <artifactId>servlet-tck-runtime</artifactId>
            <version>${servlet.tck.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.servlet</groupId>
                    <artifactId>jakarta.servlet-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Arquillian JUnit 5 -->
        <dependency>
            <groupId>org.jboss.arquillian.junit5</groupId>
            <artifactId>arquillian-junit5-container</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Servlet protocol for out-of-container testing -->
        <dependency>
            <groupId>org.jboss.arquillian.protocol</groupId>
            <artifactId>arquillian-protocol-servlet-jakarta</artifactId>
            <version>1.7.1.Final</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 4 compat for TCK infrastructure -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- SLF4J for TCK WAR deployments -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
            <scope>test</scope>
        </dependency>

        <!-- Deployment artifact for reactor ordering -->
        <dependency>
            <groupId>io.quarkiverse.servlet</groupId>
            <artifactId>quarkus-servlet-deployment</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>-Xmx1g</argLine>
                    <dependenciesToScan>
                        <dependenciesToScan>jakarta.servlet.tck:servlet-tck-runtime</dependenciesToScan>
                    </dependenciesToScan>
                    <systemPropertyVariables>
                        <servlet.tck.support.crossContext>false</servlet.tck.support.crossContext>
                        <servlet.tck.support.http2Push>false</servlet.tck.support.http2Push>
                        <servlet.tck.archive.print>true</servlet.tck.archive.print>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                    <includes>
                        <include>**/*Tests.java</include>
                    </includes>
                    <excludes>
                        <!-- Signature verification (not applicable) -->
                        <exclude>**/SigTest.java</exclude>
                        <exclude>**/SigTestServlet.java</exclude>
                        <exclude>**/signature/**</exclude>
                        <!-- Pluggability (needs web-fragment support) -->
                        <exclude>**/pluggability/**/*</exclude>
                        <exclude>servlet.tck.pluggability.**</exclude>
                        <!-- Security (needs auth infrastructure) -->
                        <exclude>**/ClientCertTests.java</exclude>
                        <exclude>**/ClientCertAnnoTests.java</exclude>
                        <exclude>**/security/**</exclude>
                        <!-- Hangs: async context full tests -->
                        <exclude>**/api/**/asynccontext/**</exclude>
                        <exclude>**/spec/async/**</exclude>
                        <!-- Hangs: HTTP upgrade, non-blocking I/O -->
                        <exclude>**/httpupgradehandler/**</exclude>
                        <exclude>**/readlistener*/**</exclude>
                        <exclude>**/writelistener*/**</exclude>
                        <!-- Hangs: HTTP/2 server push (deprecated) -->
                        <exclude>**/serverpush/**</exclude>
                        <!-- Hangs: httpservletrequest40 (async features) -->
                        <exclude>**/httpservletrequest40/**</exclude>
                        <!-- Hangs: httpservletresponse40 (trailer support) -->
                        <exclude>**/httpservletresponse40/**</exclude>
                        <!-- Hangs: httpservletrequest30/31 (session change) -->
                        <exclude>**/httpservletrequest30/**</exclude>
                        <exclude>**/httpservletrequest31/**</exclude>
                        <!-- Hangs: sessioncookieconfig -->
                        <exclude>**/sessioncookieconfig/**</exclude>
                        <!-- Hangs: httpsessionx (cross-context sessions) -->
                        <exclude>**/httpsessionx/**</exclude>
                        <!-- Needs multipart support -->
                        <exclude>**/part*/**</exclude>
                    </excludes>
                    <reuseForks>true</reuseForks>
                    <forkCount>1</forkCount>
                    <forkedProcessExitTimeoutInSeconds>300</forkedProcessExitTimeoutInSeconds>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
