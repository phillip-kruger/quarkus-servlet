<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.servlet</groupId>
        <artifactId>quarkus-servlet-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>quarkus-servlet-tck</artifactId>
    <name>Quarkus Servlet - TCK</name>
    <description>Jakarta Servlet 6.1 TCK runner for quarkus-servlet</description>

    <properties>
        <servlet.tck.version>6.1.2</servlet.tck.version>
        <servlet.tck.timeout.seconds>3600</servlet.tck.timeout.seconds>
        <!-- Booting a Quarkus application per deployment needs far more heap than driving the
             runtime directly, so this is raised well above what the direct container needs. -->
        <servlet.tck.heap>4g</servlet.tck.heap>
        <arquillian.version>1.10.2.Final</arquillian.version>
        <maven.deploy.skip>true</maven.deploy.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Our extension runtime -->
        <dependency>
            <groupId>io.quarkiverse.servlet</groupId>
            <artifactId>quarkus-servlet</artifactId>
        </dependency>

        <!-- web.xml parsing -->
        <dependency>
            <groupId>org.jboss.metadata</groupId>
            <artifactId>jboss-metadata-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.jboss.spec.javax.servlet</groupId>
                    <artifactId>jboss-servlet-api_3.1_spec</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- The TCK tests -->
        <dependency>
            <groupId>jakarta.servlet.tck</groupId>
            <artifactId>servlet-tck-runtime</artifactId>
            <version>${servlet.tck.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.servlet</groupId>
                    <artifactId>jakarta.servlet-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Arquillian JUnit 5 -->
        <dependency>
            <groupId>org.jboss.arquillian.junit5</groupId>
            <artifactId>arquillian-junit5-container</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Servlet protocol for out-of-container testing -->
        <dependency>
            <groupId>org.jboss.arquillian.protocol</groupId>
            <artifactId>arquillian-protocol-servlet-jakarta</artifactId>
            <version>1.7.1.Final</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 4 compat for TCK infrastructure -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- SLF4J for TCK WAR deployments -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
            <scope>test</scope>
        </dependency>

        <!-- Deployment artifact for reactor ordering -->
        <!-- Bootstrap/augmentation APIs, for the container that boots a real Quarkus app -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-core-deployment</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-bootstrap-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-bootstrap-maven-resolver</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.quarkiverse.servlet</groupId>
            <artifactId>quarkus-servlet-deployment</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>-Xmx${servlet.tck.heap}</argLine>
                    <dependenciesToScan>
                        <dependenciesToScan>jakarta.servlet.tck:servlet-tck-runtime</dependenciesToScan>
                    </dependenciesToScan>
                    <systemPropertyVariables>
                        <!--
                          These two are capability declarations, not test exclusions: every test
                          still runs, but the TCK asserts the behaviour of a container that does
                          not offer these optional features.

                          crossContext - ServletContext.getContext(String) returns null here, which
                          the spec explicitly permits ("if the container wishes to restrict
                          access"). Quarkus deploys a single application, so there is no second
                          context to hand out; quarkus-undertow behaves the same way.

                          http2Push - server push is deprecated in Servlet 6.1 and unimplemented by
                          current browsers.
                        -->
                        <servlet.tck.support.crossContext>false</servlet.tck.support.crossContext>
                        <servlet.tck.support.http2Push>false</servlet.tck.support.http2Push>
                        <servlet.tck.archive.print>true</servlet.tck.archive.print>
                        <!-- Which quarkus-servlet the Quarkus container resolves into the
                             application model it builds for each deployment. -->
                        <servlet.tck.extension.version>${project.version}</servlet.tck.extension.version>
                        <servlet.tck.quarkus.version>${quarkus.version}</servlet.tck.quarkus.version>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                    <includes>
                        <include>**/*Tests.java</include>
                    </includes>
                    <!--
                      No exclusions: the full Jakarta Servlet 6.1 TCK runs. Anything that fails is
                      a real gap in the implementation and must be fixed here, not filtered out.
                    -->
                    <reuseForks>true</reuseForks>
                    <forkCount>1</forkCount>
                    <forkedProcessExitTimeoutInSeconds>300</forkedProcessExitTimeoutInSeconds>
                    <!--
                      A hard cap on the whole run. Unimplemented features (HTTP trailers, the
                      non-blocking I/O listeners) currently hang their tests rather than failing
                      them, and without this the build would sit there forever instead of
                      reporting.
                    -->
                    <forkedProcessTimeoutInSeconds>${servlet.tck.timeout.seconds}</forkedProcessTimeoutInSeconds>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
